{
    "buildCommand": "npm run build:web",
    "outputDirectory": "dist",
    "crons": [
        {
            "path": "/api/cron-daily-recipe",
            "schedule": "0 0 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/showcase",
            "destination": "/api/showcase"
        },
        {
            "source": "/guide",
            "destination": "/api/guide"
        },
        {
            "source": "/privacy",
            "destination": "/api/privacy"
        },
        {
            "source": "/terms",
            "destination": "/api/terms"
        },
        {
            "source": "/about",
            "destination": "/api/about"
        },
        {
            "source": "/contact",
            "destination": "/api/contact"
        },
        {
            "source": "/r/:recipeId/:versionId",
            "destination": "/api/share?recipeId=:recipeId&versionId=:versionId"
        },
        {
            "source": "/r/:recipeId",
            "destination": "/api/share?recipeId=:recipeId"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/recipes",
            "destination": "/api/recipes"
        },
        {
            "source": "/recipes/:id",
            "destination": "/api/recipes?id=:id"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/ads.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain"
                }
            ]
        },
        {
            "source": "/service-worker.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/manifest.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/manifest+json"
                }
            ]
        }
    ]
}